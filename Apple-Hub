	bind(tabScroll, "ScrollBarImageColor3", "accent")
	local indicator = new("Frame", {Size = UDim2.new(1, -12, 0, State.TabH), Position = UDim2.fromOffset(6, 8), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 1, Parent = tabScroll})
	local indCorner = new("UICorner", {CornerRadius = UDim.new(0, 11), Parent = indicator})
	local indG = new("UIGradient", {Parent = indicator})
	bind(indG, "Color", function() return ColorSequence.new(T.accent, T.accent2) end, true)
