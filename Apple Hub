local function unload()
	alive = false
	State.AutoLevel, State.Farm, State.AutoBoss, State.Chest, State.FruitGrab = false, false, false, false, false
	State.Fly, State.Fullbright, State.NoFog, State.Water, State.GameFont = false, false, false, false, "Padrão"
	pcall(applyLight)
	pcall(applyWater)
	pcall(refreshGameFont)
	pcall(stopFly)
	pcall(stopHold)
	pcall(function() workspace.Gravity = 196.2 end)
	pcall(function() blur:Destroy() end)
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	pcall(function() gui:Destroy() end)
end
