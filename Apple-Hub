local function Slider(page, text, min, max, key, cb, suffix)
	suffix = suffix or ""
	local r = row(page, 58)
	mkText({Size = UDim2.new(0.6, 0, 0, 28), Position = UDim2.fromOffset(14, 2), Text = text, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = r}, false)
	local vl = mkText({Size = UDim2.new(0.4, -28, 0, 28), Position = UDim2.new(0.6, 14, 0, 2), Text = State[key] .. suffix, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Right, Parent = r}, true, "accent")
	local bar = new("Frame", {Size = UDim2.new(1, -28, 0, 8), Position = UDim2.fromOffset(14, 40), BackgroundColor3 = T.sub, Parent = r}, {corner(4)})
	bind(bar, "BackgroundColor3", offColor)
	local a0 = math.clamp((State[key] - min) / (max - min), 0, 1)
	local fill = new("Frame", {Size = UDim2.new(a0, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), Parent = bar}, {corner(4)})
	local fg = new("UIGradient", {Parent = fill})
	bind(fg, "Color", function() return ColorSequence.new(T.accent, T.accent2) end, true)
	new("Frame", {Size = UDim2.fromOffset(18, 18), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 0, 0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1), Parent = fill},
		{corner(9), new("UIStroke", {Color = Color3.new(0, 0, 0), Transparency = 0.8, Thickness = 1})})
	syncers[key] = function()
		fill.Size = UDim2.new(math.clamp((State[key] - min) / (max - min), 0, 1), 0, 1, 0)
		vl.Text = State[key] .. suffix
	end
	local sliding = false
	local function set(x)
		local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		local v = math.floor(min + (max - min) * a + 0.5)
		State[key] = v
		fill.Size = UDim2.new(a, 0, 1, 0)
		vl.Text = v .. suffix
		if cb then pcall(cb, v) end
	end
	local hit = new("TextButton", {Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 28), BackgroundTransparency = 1, Text = "", Parent = r})
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			if page:IsA("ScrollingFrame") then page.ScrollingEnabled = false end
			set(i.Position.X)
		end
	end)
	conn(UIS.InputChanged:Connect(function(i)
		if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then set(i.Position.X) end
	end))
	conn(UIS.InputEnded:Connect(function(i)
		if sliding and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
			sliding = false
			if page:IsA("ScrollingFrame") then page.ScrollingEnabled = true end
		end
	end))
end

local Button
do
	local reg = {}
	local function styleBtn(e)
		local s, white = State.BtnStyle, Color3.new(1, 1, 1)
		e.h.Size = UDim2.new(1, -4, 0, State.BtnH)
		e.cr.CornerRadius = UDim.new(0, State.BtnCorner)
		e.lbl.TextSize = State.BtnTextSize
		e.shine.Visible = State.BtnShine
		if s == "Sólido" then
			e.g.Enabled = false; e.b.BackgroundColor3 = T.accent; e.b.BackgroundTransparency = 0; e.st.Enabled = false; e.lbl.TextColor3 = white
		elseif s == "Vidro" then
			e.g.Enabled = false; e.b.BackgroundColor3 = T.row; e.b.BackgroundTransparency = 0.1; e.st.Enabled = true; e.st.Thickness = 1; e.lbl.TextColor3 = T.text
		elseif s == "Neon" then
			e.g.Enabled = false; e.b.BackgroundColor3 = T.accent; e.b.BackgroundTransparency = 0.88; e.st.Enabled = true; e.st.Thickness = 2; e.lbl.TextColor3 = T.accent
		else
			e.g.Enabled = true; e.b.BackgroundColor3 = white; e.b.BackgroundTransparency = 0; e.st.Enabled = true; e.st.Thickness = 1; e.lbl.TextColor3 = white
		end
	end
	restyleButtons = function() for _, e in ipairs(reg) do pcall(styleBtn, e) end end
	Button = function(page, text, cb)
		local h = new("CanvasGroup", {Size = UDim2.new(1, -4, 0, State.BtnH), BackgroundTransparency = 1, Parent = page})
		local cr = new("UICorner", {CornerRadius = UDim.new(0, State.BtnCorner), Parent = h})
		local st = new("UIStroke", {Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Enabled = false, Parent = h})
		bind(st, "Color", "accent")
		local sc = new("UIScale", {Parent = h})
		local b = new("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), Text = "", AutoButtonColor = false, Parent = h})
		local g = new("UIGradient", {Parent = b})
		bind(g, "Color", function() return ColorSequence.new(T.accent, T.accent2) end, true)
		local shine = new("Frame", {Size = UDim2.new(0, 36, 2, 0), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(-0.3, 0, 0.5, 0), Rotation = 18,
			BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.8, BorderSizePixel = 0, Parent = b})
		local lbl = mkText({Size = UDim2.fromScale(1, 1), Text = text, TextSize = State.BtnTextSize, TextColor3 = Color3.new(1, 1, 1), Parent = b}, true, false)
		local e = {h = h, cr = cr, st = st, b = b, g = g, shine = shine, lbl = lbl}
		table.insert(reg, e)
		table.insert(binders, function() styleBtn(e) end)
		styleBtn(e)
		local function sweep()
			if not State.BtnShine then return end
			shine.Position = UDim2.new(-0.3, 0, 0.5, 0)
			tween(shine, 0.7, {Position = UDim2.new(1.15, 0, 0.5, 0)}, Enum.EasingStyle.Quad)
		end
		b.MouseEnter:Connect(function() if State.BtnHover then tween(sc, 0.2, {Scale = 1.02}); sweep() end end)
		b.MouseLeave:Connect(function() tween(sc, 0.2, {Scale = 1}) end)
		b.MouseButton1Down:Connect(function() tween(sc, 0.08, {Scale = 0.96}) end)
		b.MouseButton1Up:Connect(function() tween(sc, 0.25, {Scale = 1}, Enum.EasingStyle.Back) end)
		b.MouseButton1Click:Connect(function()
			sweep()
			task.spawn(function() local ok, err = pcall(cb); if not ok then H.err(err); notify("Erro", tostring(err), 3, "error") end end)
		end)
		return h
	end
end

local function Input(page, text, placeholder, cb)
	local r = row(page, 42)
	mkText({Size = UDim2.new(0.4, 0, 1, 0), Position = UDim2.fromOffset(14, 0), Text = text, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = r}, false)
