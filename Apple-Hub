	local chip = new("Frame", {Size = UDim2.new(1, -12, 0, 40), Position = UDim2.new(0, 6, 1, -46), BackgroundColor3 = T.row, BackgroundTransparency = 0.25, Parent = side}, {rc(12)})
	bind(chip, "BackgroundColor3", "row")
	local chipAv = new("ImageLabel", {Size = UDim2.fromOffset(28, 28), Position = UDim2.fromOffset(6, 6), BackgroundColor3 = T.side, Parent = chip}, {corner(14)})
	bind(chipAv, "BackgroundColor3", "side")
	mkText({Size = UDim2.new(1, -44, 0, 18), Position = UDim2.fromOffset(40, 3), Text = lp.DisplayName, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = chip}, true)
	H.chipLv = mkText({Size = UDim2.new(1, -44, 0, 14), Position = UDim2.fromOffset(40, 21), Text = "Lv —", TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, Parent = chip}, false, "accent")
	task.spawn(function()
		local ok, img = pcall(function() return S.Players:GetUserThumbnailAsync(lp.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150) end)
		if ok then chipAv.Image = img; H.avatar = img end
	end)
	local content = new("Frame", {Size = UDim2.new(1, -(State.SideW + 24), 1, -50), Position = UDim2.fromOffset(State.SideW + 18, 42), BackgroundTransparency = 1, ClipsDescendants = true, Parent = main})

	local pages, pageScale, tabY, tabIdx, current, tabCount = {}, {}, {}, {}, nil, 0
	local tabBtns, tabIcons, tabPads = {}, {}, {}
	local function P(ox, oy) return UDim2.new(0.5, ox, 0.5, oy) end
	local function indPos(name)
		local y = tabY[name] or 8
		if State.TabStyle == "Linha" then return UDim2.fromOffset(6, y + 6) end
		return UDim2.fromOffset(6, y)
	end
	local function activeTabColor()
		local s = State.TabStyle
		if s == "Pílula" then return Color3.new(1, 1, 1) elseif s == "Contorno" or s == "Suave" then return T.accent end
		return T.text
	end
	local function tabText(name)
		local ic = tabIcons[name]
		if State.TabIcons and State.TabNames then return ic .. "  " .. name elseif State.TabIcons then return ic end
		return name
	end
	local function updateIndicator()
		local s, h = State.TabStyle, State.TabH
		if s == "Linha" then
			indicator.Size = UDim2.fromOffset(4, h - 12)
			indicator.BackgroundTransparency = 0
			indStroke.Enabled = false
			indCorner.CornerRadius = UDim.new(0, 2)
		else
			indicator.Size = UDim2.new(1, -12, 0, h)
			indCorner.CornerRadius = UDim.new(0, math.floor(11 * State.Corner / 16 + 0.5))
			if s == "Contorno" then indicator.BackgroundTransparency = 1; indStroke.Enabled = true
			elseif s == "Suave" then indicator.BackgroundTransparency = 0.6; indStroke.Enabled = true
			else indicator.BackgroundTransparency = 0; indStroke.Enabled = false end
		end
		if current then indicator.Position = indPos(current) end
	end

	switchTab = function(name)
		if current == name or not pages[name] then return end
		local oldName = current
		current = name
		for _, f in ipairs(tabRefresh) do f(0.25) end
		local tt = math.max(State.TransTime, 50) / 1000
		local es = ease()
		local kind = State.Transition
		tween(indicator, tt, {Position = indPos(name)}, es)
		local dir = (oldName and tabIdx[name] < tabIdx[oldName]) and -1 or 1
		if oldName then
			local old, oldS = pages[oldName], pageScale[oldName]
			if kind == "Nenhuma" then
				old.Visible = false
			else
				local goal = {GroupTransparency = 1}
				if kind == "Deslizar" then goal.Position = P(-30 * dir, 0)
				elseif kind == "Subir" then goal.Position = P(0, -30 * dir)
				elseif kind == "Girar" then goal.Rotation = -8 * dir end
				tween(old, tt * 0.5, goal, Enum.EasingStyle.Quad)
				if kind == "Zoom" or kind == "Pop" then tween(oldS, tt * 0.5, {Scale = 1.06}, Enum.EasingStyle.Quad) end
				task.delay(tt * 0.5 + 0.03, function() if current ~= oldName then old.Visible = false end end)
			end
		end
		local pg, ps = pages[name], pageScale[name]
		pg.Position = P(0, 0)
		pg.Rotation = 0
		ps.Scale = 1
		if kind == "Deslizar" then pg.Position = P(34 * dir, 0)
		elseif kind == "Subir" then pg.Position = P(0, 34 * dir)
		elseif kind == "Zoom" then ps.Scale = 0.9
		elseif kind == "Pop" then ps.Scale = 0.7
		elseif kind == "Girar" then pg.Rotation = 8 * dir end
		pg.GroupTransparency = (kind == "Nenhuma") and 0 or 1
		pg.Visible = true
		if kind == "Nenhuma" then return end
		task.delay(tt * 0.2, function()
			if current ~= name then return end
			tween(pg, tt, {GroupTransparency = 0, Position = P(0, 0), Rotation = 0}, es)
			tween(ps, tt, {Scale = 1}, es)
		end)
	end

	addPage = function(name, icon)
		local grp = new("CanvasGroup", {Size = UDim2.fromScale(1, 1), AnchorPoint = Vector2.new(0.5, 0.5), Position = P(0, 0), BackgroundTransparency = 1, GroupTransparency = 1, Visible = false, Parent = content})
		local ps = new("UIScale", {Parent = grp})
		local layout = new("UIListLayout", {Padding = UDim.new(0, State.ListPad), SortOrder = Enum.SortOrder.LayoutOrder})
		table.insert(pageLists, layout)
		local sc = new("ScrollingFrame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
			AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = grp},
			{layout, new("UIPadding", {PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 12)})})
		bind(sc, "ScrollBarImageColor3", "accent")
		pages[name], pageScale[name] = grp, ps
		tabCount = tabCount + 1
		tabIdx[name], tabIcons[name] = tabCount, icon
		tabY[name] = 8 + (tabCount - 1) * (State.TabH + State.TabGap)
		local btn = mkText({Size = UDim2.new(1, -12, 0, State.TabH), Position = UDim2.fromOffset(6, tabY[name]), Text = tabText(name), TextSize = State.TabTextSize,
			TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 2, AutoButtonColor = false, Parent = tabScroll}, true, false, "TextButton")
		tabPads[name] = new("UIPadding", {PaddingLeft = UDim.new(0, 12), Parent = btn})
		tabBtns[name] = btn
		local refresh = function(d) tween(btn, d or 0.2, {TextColor3 = current == name and activeTabColor() or T.sub}) end
		table.insert(tabRefresh, refresh)
		table.insert(binders, refresh)
		btn.TextColor3 = T.sub
		btn.MouseButton1Click:Connect(function() switchTab(name) end)
		return sc
	end

	relayout = function()
		local sw = State.SideW
		side.Size = UDim2.new(0, sw, 1, -50)
		content.Position = UDim2.fromOffset(sw + 18, 42)
		content.Size = UDim2.new(1, -(sw + 24), 1, -50)
		chip.Visible = State.ShowChip
		tabScroll.Size = UDim2.new(1, 0, 1, State.ShowChip and -52 or -8)
		local step = State.TabH + State.TabGap
		local count = 0
		local center = (State.TabIcons and not State.TabNames) or State.TabAlign == "Centro"
		for name, idx in pairs(tabIdx) do
			count = count + 1
			tabY[name] = 8 + (idx - 1) * step
			local b = tabBtns[name]
			b.Size = UDim2.new(1, -12, 0, State.TabH)
			b.Position = UDim2.fromOffset(6, tabY[name])
			b.TextSize = State.TabTextSize
			b.Text = tabText(name)
			b.TextXAlignment = center and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left
			tabPads[name].PaddingLeft = UDim.new(0, center and 0 or 12)
		end
		tabScroll.CanvasSize = UDim2.fromOffset(0, 16 + count * step)
		updateIndicator()
		for _, f in ipairs(tabRefresh) do f(0) end
	end
end

