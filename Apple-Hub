		local list
		local function rebuild()
			clear(list)
			for _, name in ipairs(sortedKeys(H.db.themes)) do Button(list, "Aplicar: " .. name, function() applyTheme(name) end) end
		end
		local function addTheme(name, hex7)
			name = name:gsub("[^%w_%-]", "")
			if name == "" or name == "Custom" then notify("Tema", "Nome inválido", 3, "warn") return end
			if Themes[name] and not H.db.themes[name] then notify("Tema", "Esse nome já é de um tema do hub", 3, "warn") return end
			local ok, t = pcall(function() return th(table.unpack(hex7)) end)
			if not ok or #hex7 ~= 7 then notify("Tema", "Preciso de 7 cores hex válidas", 3, "error") return end
			if not Themes[name] then table.insert(ThemeNames, #ThemeNames, name) end
			Themes[name] = t
			H.db.themes[name] = hex7
			H.save(true)
			rebuild()
			applyTheme(name)
			notify("Tema", name .. " criado!", 2.5, "ok")
