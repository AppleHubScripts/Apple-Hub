	H.hook = function(msg)
		local url = State.HookURL
		if not (url:match("^https://[%w%.]*discord%.com/api/webhooks/") or url:match("^https://[%w%.]*discordapp%.com/api/webhooks/")) then return false end
		local req = request or http_request or (syn and syn.request)
		if not req then return false end
		return (pcall(function()
			req({Url = url, Method = "POST", Headers = {["Content-Type"] = "application/json"},
				Body = S.HttpService:JSONEncode({content = msg, username = "Apple Hub", allowed_mentions = {parse = {}}})})
		end))
	end

