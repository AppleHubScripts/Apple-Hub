			table.insert(queue, {t = State.QType, v = n})
			H.save(true)
			showQ()
		end)
		local running = false
		local function sleep(n) local t = tick() while running and alive and tick() - t < n do task.wait(0.3) end end
		local function setOnly(k)
			for _, kk in ipairs(H.autoKeys) do State[kk] = false end
			if k then State[k] = true end
			syncUI()
		end
		local function waitUntil(cond, timeout)
			local t = tick()
			while running and alive and not cond() and tick() - t < timeout do task.wait(1) end
		end
		local function run()
			if running or #queue == 0 then return end
			running = true
			notify("Fila", "Executando " .. #queue .. " passos", 3)
			for i, q in ipairs(queue) do
				if not running or not alive then break end
				qLbl.Text = "Passo " .. i .. "/" .. #queue .. ": " .. q.t .. " " .. q.v
				if q.t == "Level até" then setOnly("AutoLevel"); waitUntil(function() return (dataVal("Level") or 0) >= q.v end, 18000)
				elseif q.t == "Baús (seg)" then setOnly("Chest"); sleep(q.v)
				elseif q.t == "Boss (seg)" then setOnly("AutoBoss"); sleep(q.v)
				elseif q.t == "Raid (seg)" then setOnly("AutoRaid"); sleep(q.v)
				elseif q.t == "Material até" then
					setOnly("MatFarm")
					waitUntil(function() return (invCount(State.Material) or 0) >= q.v end, 3600)
				elseif q.t == "Mar (1-3)" then
					setOnly(nil)
					invoke(q.v == 1 and "TravelMain" or (q.v == 2 and "TravelDressrosa" or "TravelZou"))
					sleep(20)
				else setOnly(nil); sleep(q.v) end
			end
			setOnly(nil)
			running = false
			showQ()
			notify("Fila", "Fila finalizada", 4, "ok")
		end
		Button(pAdv, "▶ Executar fila", function() task.spawn(run) end)
		Button(pAdv, "■ Parar fila", function() running = false; setOnly(nil); showQ() end)
