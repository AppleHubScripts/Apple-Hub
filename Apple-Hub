		Confete = {PartShape = "Quadrado", PartCount = 70, PartSpeed = 75, PartSize = 9, PartTrans = 10, PartWind = 0, PartDir = "Cair", PartColor = "Arco-íris", PartSpin = true, PartTwinkle = false},
		Estrelas = {PartShape = "Estrela", PartCount = 40, PartSpeed = 22, PartSize = 11, PartTrans = 20, PartWind = 0, PartDir = "Esquerda → Direita", PartColor = "Tema", PartSpin = false, PartTwinkle = true},
		Sakura = {PartShape = "Flor", PartCount = 35, PartSpeed = 28, PartSize = 13, PartTrans = 15, PartWind = 25, PartDir = "Cair", PartColor = "Personalizada", PartR = 255, PartG = 150, PartB = 200, PartSpin = true, PartTwinkle = false},
	}
	H.PartShapes, H.PartPresets = PartShapes, PartPresets
	H.PartShapeNames = {"Círculo", "Floco", "Estrela", "Coração", "Flor", "Ponto", "Diamante", "Quadrado", "Linha", "Nota"}
	H.PartDirNames = {"Cair", "Subir", "Diagonal →", "Diagonal ←", "Esquerda → Direita", "Direita → Esquerda"}
	H.PartPresetNames = {"Neve", "Chuva", "Brasas", "Confete", "Estrelas", "Sakura"}
	local parts = {}
	local function partColor(p)
		local m = State.PartColor
		if m == "Tema" then return T.accent
		elseif m == "Tema 2" then return T.accent2
		elseif m == "Misto" then return p.alt and T.accent or T.accent2
		elseif m == "Arco-íris" then return Color3.fromHSV((p.h + tick() * 0.05) % 1, 0.6, 1)
		elseif m == "Personalizada" then return Color3.fromRGB(State.PartR, State.PartG, State.PartB) end
		return Color3.new(1, 1, 1)
	end
	local function addPart()
		table.insert(parts, {
			o = new("TextLabel", {AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Size = UDim2.fromOffset(30, 30), Font = Enum.Font.GothamBold,
				Text = PartShapes[State.PartShape] or "●", TextSize = State.PartSize, Active = false, Parent = partLayer}),
			x = math.random() * State.PW, y = math.random() * State.PH, v = 0.55 + math.random() * 0.9, s = 0.5 + math.random() * 0.9,
			ph = math.random() * 6.28, a = 4 + math.random() * 14, h = math.random(), alt = math.random() < 0.5, rs = (math.random() - 0.5) * 2,
		})
	end
	H.refreshParts = function()
		local tx = PartShapes[State.PartShape] or "●"
		for _, p in ipairs(parts) do p.o.Text = tx end
		partLayer.ZIndex = State.PartFront and 50 or 1
	end
	H.applyPartPreset = function(name)
		local pr = PartPresets[name]
		if not pr then return end
		for k, v in pairs(pr) do State[k] = v end
		syncUI()
		H.refreshParts()
	end
	H.clearParts = function() for _, p in ipairs(parts) do p.o:Destroy() end parts = {} end
	conn(RS.RenderStepped:Connect(function(dt)
		H.frames = H.frames + 1
		if not main.Visible then return end
		if not State.PartOn then
			if #parts > 0 then H.clearParts() end
			return
		end
		local want = math.clamp(State.PartCount, 0, 200)
		while #parts < want do addPart() end
		while #parts > want do local p = table.remove(parts) p.o:Destroy() end
		local d = PartDirs[State.PartDir] or PartDirs["Cair"]
		local pw, ph, now, base = State.PW, State.PH, tick(), State.PartTrans / 100
		for _, p in ipairs(parts) do
			local sp = State.PartSpeed * p.v
			p.x = p.x + (d[1] * sp + State.PartWind * p.v) * dt
			p.y = p.y + d[2] * sp * dt
			if p.y > ph + 20 then p.y = -20; p.x = math.random() * pw
			elseif p.y < -20 then p.y = ph + 20; p.x = math.random() * pw end
			if p.x > pw + 20 then p.x = -20; p.y = math.random() * ph
			elseif p.x < -20 then p.x = pw + 20; p.y = math.random() * ph end
			local o = p.o
			o.Position = UDim2.fromOffset(p.x + math.sin(now * 1.3 + p.ph) * p.a, p.y)
			o.TextSize = math.max(2, State.PartSize * p.s)
			o.TextColor3 = partColor(p)
			local tw = base
			if State.PartTwinkle then tw = base + (1 - base) * 0.45 * (0.5 + 0.5 * math.sin(now * 2.2 + p.ph * 3)) end
			o.TextTransparency = math.clamp(tw, 0, 1)
			o.Rotation = State.PartSpin and (now * 50 * p.rs) % 360 or 0
		end
	end))
end

